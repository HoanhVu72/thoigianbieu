rules_version = '2';
// LUẬT BẢO MẬT FIRESTORE – dán toàn bộ vào Firebase Console > Firestore Database > Rules > Publish
// Lưu ý: nếu đổi ADMIN_USERNAME, EMAIL_DOMAIN hoặc GRACE_MINUTES trong config.js thì sửa tương ứng ở đây.
//   - Tên admin = ADMIN_USERNAME (mặc định 'admin'), đuôi email nội bộ = EMAIL_DOMAIN (mặc định tgb.app)
//   - Hạn tick do người dùng chọn cho từng việc: tối đa 24 giờ sau khi việc kết thúc
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin = người có hồ sơ với tên đăng nhập 'admin' (vẫn đúng sau khi gắn email khôi phục)
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == 'admin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Cài đặt quỹ (mã QR MoMo, tên, số điện thoại): ai đăng nhập cũng xem được, chỉ admin sửa
    // Bảng tên đăng nhập → email (để đăng nhập bằng tên & gửi link quên mật khẩu)
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email == name + '@tgb.app'
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Tên đăng nhập trong hồ sơ phải trùng với email đăng nhập (chống tự xưng admin)
      allow create: if isOwner(uid)
        && request.auth.token.email == request.resource.data.username + '@tgb.app'
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow update: if (isOwner(uid) && request.resource.data.username == resource.data.username) || isAdmin();

      // Nhiệm vụ: có giờ bắt đầu (start), kết thúc (end), hạn tick (deadline)
      function validTimes(d) {
        return d.start is timestamp && d.end is timestamp && d.deadline is timestamp
          && d.end > d.start && d.end <= d.start + duration.value(20, 'h')
          && d.deadline >= d.end && d.deadline <= d.end + duration.value(24, 'h');
      }
      match /tasks/{taskId} {
        allow read: if isOwner(uid) || isAdmin();

        // Chỉ tạo việc chưa kết thúc; mặc định chưa hoàn thành
        allow create: if isOwner(uid)
          && validTimes(request.resource.data)
          && request.resource.data.end > request.time
          && request.resource.data.done == false;

        // Sửa/tick: trước hạn chót; không đổi giờ; chỉ đổi hạn tick khi việc chưa bắt đầu;
        // chỉ tick khi việc đã bắt đầu
        allow update: if isOwner(uid)
          && request.time < resource.data.deadline
          && validTimes(request.resource.data)
          && request.resource.data.start == resource.data.start
          && request.resource.data.end == resource.data.end
          && request.resource.data.date == resource.data.date
          && (request.resource.data.deadline == resource.data.deadline || request.time < resource.data.start)
          && (request.resource.data.done == resource.data.done || request.time >= resource.data.start);

        // Chỉ xoá được khi việc chưa bắt đầu (admin xoá được mọi lúc)
        allow delete: if (isOwner(uid) && request.time < resource.data.start) || isAdmin();
      }

      // Báo nộp quỹ: người dùng chỉ tạo ở trạng thái chờ duyệt; chỉ admin xác nhận/từ chối
      match /payments/{payId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update, delete: if isAdmin();
      }
    }
  }
}
